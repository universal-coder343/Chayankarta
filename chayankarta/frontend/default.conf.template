server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ── SPA routing: fallback to index.html ──────────────────────────────
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── Reverse-proxy /api → backend (Railway private networking) ────────
    # Set BACKEND_URL to the backend's internal URL, e.g.:
    #   http://chayankarta-api.railway.internal:8000
    location /api/ {
        proxy_pass         ${BACKEND_URL}/api/;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        client_max_body_size 50M;
    }

    # ── Proxy /health endpoint ───────────────────────────────────────────
    location /health {
        proxy_pass         ${BACKEND_URL}/health;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
    }

    # ── Cache static assets (Vite hashes filenames) ──────────────────────
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # ── Gzip ─────────────────────────────────────────────────────────────
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;
    gzip_min_length 256;
}

