# MongoDB
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=resume_screening

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Logging
LOG_LEVEL=INFO

# File uploads
UPLOAD_DIR=./uploads

# ── Milestone 4: Semantic Ranking ──────────────────────────────────────────
# Sentence-Transformers model (downloaded automatically on first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Hybrid scoring weights (must sum to 1.0)
WEIGHT_SEMANTIC=0.40
WEIGHT_SKILL=0.35
WEIGHT_EXPERIENCE=0.15
WEIGHT_EDUCATION=0.10

# ── Milestone 5: Fairness & PII Redaction ─────────────────────────────────
# Master toggle — set to false to disable redaction (scores will use raw text)
ENABLE_REDACTION=true

# Also redact college/institution names for blind screening
REDACT_INSTITUTIONS=false
